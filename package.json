{
  "name": "mes_core_testing",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently \"npm run react\" \"npm run electron\"",
    "react": "vite",
    "electron": "wait-on http://localhost:5173 && nodemon --watch electron --ext cjs --delay 1 --exec electron .",
    "build": "vite build",
    "dist": "npm run build && electron-builder --win"
  },
  "build": {
    "appId": "com.mes.core-testing",
    "productName": "MES Core Testing",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/logo.png",
      "public/logo.ico",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "public/logo.ico"
    }
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^9.4.0",
    "dotenv": "^17.4.2",
    "playwright": "^1.55.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "nodemon": "^3.1.14",
    "vite": "^8.3.0",
    "wait-on": "^9.1.0"
  }
}
